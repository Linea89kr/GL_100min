# Vercel → Project → Settings → Environment Variables 에 넣을 값 (이 파일은 예시, 실제 값 커밋 금지)
SUPABASE_URL=https://dxolegtsnkgzjonjakje.supabase.co
SUPABASE_ANON_KEY=            # Supabase → Project Settings → API → anon / publishable key (공개돼도 되는 키)
SUPABASE_SERVICE_ROLE_KEY=    # 같은 화면의 service_role / secret key (절대 브라우저·레포에 노출 금지)
ANTHROPIC_API_KEY=            # 판정/해설 LLM. 없으면 판정은 "오답" 기본값, 해설은 생략
